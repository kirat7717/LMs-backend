{
  "info": {
    "_postman_id": "student-lms-collection",
    "name": "LMS - Student APIs",
    "description": "Student authentication, email verification, password and profile APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"bio\": \"Backend learner\",\n  \"avatar\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "register"
          ]
        }
      }
    },
    {
      "name": "Verify Student Email",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/verify-email?token={{verificationToken}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "verify-email"
          ],
          "query": [
            {
              "key": "token",
              "value": "{{verificationToken}}"
            }
          ]
        }
      }
    },
    {
      "name": "Resend Verification Email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/resend-verification",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "resend-verification"
          ]
        }
      }
    },
    {
      "name": "Login Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "login"
          ]
        }
      }
    },
    {
      "name": "Forgot Student Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "forgot-password"
          ]
        }
      }
    },
    {
      "name": "Reset Student Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewPassword123\",\n  \"confirmPassword\": \"NewPassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "reset-password"
          ]
        }
      }
    },
    {
      "name": "Update Student Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"bio\": \"Full stack developer\",\n  \"avatar\": \"http://localhost:9000/images/avatar.png\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "profile"
          ]
        }
      }
    }
  ]
}