{
  "info": {
    "_postman_id": "super-admin-lms-collection",
    "name": "LMS - Super Admin APIs",
    "description": "Super Admin authentication and Super Admin-only Admin management APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@example.com\",\n  \"password\": \"StrongPassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/super-admin/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "super-admin", "login"]
        }
      }
    },
    {
      "name": "Forgot Super Admin Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/super-admin/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "super-admin", "forgot-password"]
        }
      }
    },
    {
      "name": "Reset Super Admin Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewPassword123\",\n  \"confirmPassword\": \"NewPassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/super-admin/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "super-admin", "reset-password"]
        }
      }
    },
    {
      "name": "Update Super Admin Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Super Admin\",\n  \"bio\": \"LMS platform owner\",\n  \"avatar\": \"http://localhost:9000/images/super-admin.png\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/super-admin/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "super-admin", "profile"]
        }
      }
    },
    {
      "name": "Create Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Admin\",\n  \"email\": \"admin@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admins",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admins"]
        }
      }
    },
    {
      "name": "List Admins",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admins",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admins"]
        }
      }
    },
    {
      "name": "Get Admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admins/{{adminId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admins", "{{adminId}}"]
        }
      }
    },
    {
      "name": "Block / Unblock Admin",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isBlocked\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admins/{{adminId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admins", "{{adminId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Admin",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admins/{{adminId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admins", "{{adminId}}"]
        }
      }
    }
  ]
}