{
  "info": {
    "_postman_id": "teacher-lms-collection",
    "name": "LMS - Teacher APIs",
    "description": "Teacher registration, authentication, password and profile APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Teacher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amit Kumar\",\n  \"email\": \"amit@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"phone\": \"9876543210\",\n  \"qualification\": \"B.Tech Computer Science\",\n  \"experience\": 5,\n  \"specialization\": [\"Node.js\", \"MongoDB\"],\n  \"bio\": \"Backend developer and instructor\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teachers/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "teachers", "register"]
        }
      }
    },
    {
      "name": "Login Teacher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"amit@example.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teachers/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "teachers", "login"]
        }
      }
    },
    {
      "name": "Forgot Teacher Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"amit@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teachers/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "teachers", "forgot-password"]
        }
      }
    },
    {
      "name": "Reset Teacher Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewPassword123\",\n  \"confirmPassword\": \"NewPassword123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teachers/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "teachers", "reset-password"]
        }
      }
    },
    {
      "name": "Update Teacher Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{teacherToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amit Kumar\",\n  \"bio\": \"Senior Backend Instructor\",\n  \"avatar\": \"http://localhost:9000/images/avatar.png\",\n  \"phone\": \"9876543210\",\n  \"qualification\": \"M.Tech Computer Science\",\n  \"experience\": 7,\n  \"specialization\": [\"Node.js\", \"Express\", \"MongoDB\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/teachers/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "teachers", "profile"]
        }
      }
    }
  ]
}